#!/system/bin/sh
# TEESimulator daemon launcher (fateh7 — hardened)
# Picks the classpath, then execs app_process. The supervisor restarts us if we
# ever exit, so a transient keystore hiccup self-heals instead of staying down.

MODDIR=$1

# Determine classpath (dex preferred, apk fallback)
if [ -f "$MODDIR/classes.dex" ]; then
    CLASSPATH="$MODDIR/classes.dex"
elif [ -f "$MODDIR/service.apk" ]; then
    CLASSPATH="$MODDIR/service.apk"
else
    echo "Error: neither classes.dex nor service.apk found in $MODDIR"
    exit 1
fi

# Wait until keystore2 is actually up before we hook it (avoids a race on cold
# boot where app_process starts before the service is registered).
i=0
while [ "$i" -lt 30 ]; do
    getprop init.svc.keystore2 2>/dev/null | grep -q running && break
    sleep 1
    i=$((i + 1))
done

exec /system/bin/app_process -Djava.class.path="$CLASSPATH" "$MODDIR" \
    --nice-name=TEESimulator org.matrix.TEESimulator.App
